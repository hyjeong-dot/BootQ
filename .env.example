# 복사해서 .env로 쓰세요 (.env는 git에 올라가지 않습니다)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# 모델 (비우면 코드 기본값). --model 옵션이 있으면 그것이 우선입니다
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=   (기본값 없음: OpenRouter를 쓰려면 직접 지정. 무료 모델은 자주 바뀐다)

# DB (docker compose). 로컬 전용이라 기본값(bootq)을 그대로 써도 됩니다 — 포트는 127.0.0.1에만 열립니다
# POSTGRES_USER=bootq
# POSTGRES_PASSWORD=bootq
# POSTGRES_DB=bootq
# POSTGRES_PORT=5432
# API_PORT=8000
# 호스트에서 스크립트·테스트가 쓰는 주소 (비우면 아래 기본값). 위 값을 바꾸면 같이 바꾸세요
# DATABASE_URL=postgresql://bootq:bootq@127.0.0.1:5432/bootq
# TEST_DATABASE_URL=postgresql://bootq:bootq@127.0.0.1:5432/bootq_test
